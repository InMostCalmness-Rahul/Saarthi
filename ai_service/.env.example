# Groq-only configuration (required)
GROQ_API_KEY=gsk_your_groq_key_here
API_BASE_URL=https://api.groq.com/openai/v1
MODEL=openai/gpt-oss-20b
# Temperature: 0.0 (deterministic) .. 1.0 (creative). Default tuned for human-like replies.
TEMPERATURE=0.85
MAX_TOKENS=300
REQUEST_TIMEOUT_SECONDS=15
PORT=8000
HOST=127.0.0.1

# Comma-separated CORS allow-list. Never use "*": this service is called by the
# Saarthi backend, not by arbitrary browsers.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional shared secret. When set, every request must send it as
# X-Internal-Api-Key (the backend uses AI_SERVICE_API_KEY for the same value).
INTERNAL_API_KEY=

# Auto-reloader for development. Must remain false in production: it spawns a
# file watcher and a supervisor process.
DEBUG=false

# error | warning | info | debug (identifiers in logs are pseudonymized)
LOG_LEVEL=INFO

# Notes:
# - Place this file at ai_service/.env and fill in your GROQ_API_KEY before starting the ai_service.
# - This project uses Groq as the single supported LLM provider.
# - The GROQ_API_BASE_URL / GROQ_MODEL / GROQ_TEMPERATURE aliases are also accepted
#   so the GitHub Actions secrets can be reused without renaming.

