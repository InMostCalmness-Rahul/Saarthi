# Groq-only configuration (required)
GROQ_API_KEY=gsk_your_groq_key_here
API_BASE_URL=https://api.groq.com/openai/v1
MODEL=openai/gpt-oss-20b
# Temperature: 0.0 (deterministic) .. 1.0 (creative). Default tuned for human-like replies.
TEMPERATURE=0.85
MAX_TOKENS=300
PORT=8000
HOST=127.0.0.1
# Notes:
# - Place this file at ai_service/.env and fill in your GROQ_API_KEY before starting the ai_service.
# - This project uses Groq as the single supported LLM provider.
