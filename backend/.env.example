PORT=5000
NODE_ENV=development

# MongoDB connection (local or Atlas)
MONGODB_URI=mongodb://localhost:27017/saarthi

# Python AI service
AI_SERVICE_URL=http://127.0.0.1:8000
AI_SERVICE_TIMEOUT_MS=10000
# Shared secret sent to the AI service as X-Internal-Api-Key (optional locally,
# recommended in production together with ai_service INTERNAL_API_KEY)
AI_SERVICE_API_KEY=

# REQUIRED in production: random string of at least 32 characters used to sign
# session tokens. Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# If unset outside production an ephemeral secret is generated and logged as a
# warning, which invalidates sessions on every restart.
AUTH_SECRET=
AUTH_TOKEN_TTL_DAYS=30

# Comma-separated origin allow-list for CORS (no wildcard)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Request-body size limit and log verbosity: error | warn | info | debug
JSON_BODY_LIMIT=32kb
LOG_LEVEL=info
# Salt used to pseudonymize identifiers in logs (per-process random if unset)
LOG_SALT=

# Rate limits (per minute, per client IP)
AUTH_RATE_LIMIT_MAX=30
CHAT_RATE_LIMIT_MAX=60
WRITE_RATE_LIMIT_MAX=30
# Set to 1 to disable rate limiting (used by automated tests)
RATE_LIMIT_DISABLED=

# Number of trusted proxy hops in front of the app; keep 0 unless behind a proxy
TRUST_PROXY_HOPS=0

